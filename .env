# FHRS root environment — the one switch (PROMPT.md, "The one switch").
# This file is committed on purpose: it holds no secrets, only deployment-neutral
# config. Secrets (real DB passwords, tokens) go in .env.local, which is gitignored;
# pydantic-settings reads .env then .env.local.
#
# Set the country; geography, gazetteer, institutions, branding, languages and the
# national-footprint definition all follow from countries/<code>/.
FHRS_COUNTRY_CODE=SA

FHRS_DATABASE_URL=postgresql+psycopg://fhrs:fhrs@localhost:15432/fhrs
FHRS_PAYLOAD_DIR=./data/payloads
FHRS_NUMBERS_OUT=./build/numbers.json

# Ops guardrails (N9): doctor fails when free space on the payload volume drops
# below this percentage.
FHRS_DISK_WATERMARK_PCT=90

# Ports for docker-compose.
FHRS_DB_PORT=15432
FHRS_API_PORT=8081
